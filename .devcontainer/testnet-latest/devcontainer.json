{
  "name": "SAM testnet (latest from main)",
  "build": {
    "dockerfile": "../testnet/Dockerfile",
    "args": { "SAM_CHANNEL": "latest" }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "SAM mesh (sam-one)", "protocol": "http" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["site/content/docs/guides/codespaces.md"]
    }
  }
}
