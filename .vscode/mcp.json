{
  "inputs": [
    {
      "type": "promptString",
      "id": "agentmesh-api-token",
      "description": "Agent Mesh node API token (the AGENTMESH_API_TOKEN the node was started with)",
      "password": true
    }
  ],
  "servers": {
    "agentmesh": {
      "type": "http",
      "url": "http://localhost:8080/mcp",
      "headers": {
        "X-Mesh-Authentication": "Bearer ${input:agentmesh-api-token}"
      }
    }
  }
}
