[242.128579, "o", "\u001b[?25l\r\u001b[66A  \u001b[38;5;189m2\u001b[m\u001b[38;5;189m. \u001b[m\u001b[38;5;189mWe launched \u001b[m\u001b[38;5;111;48;5;236msam-node\u001b[m\u001b[38;5;189m in the background (daemonized), establishing your entry point into the SAM\u001b[m\u001b[38;5;189m network.\u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m"]
