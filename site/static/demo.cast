[175.733924, "o", "\u001b[?25l\r\u001b[66A\u001b[38;5;111m●\u001b[m \u001b[1;38;5;214mManageTask\u001b[m\u001b[38;5;146m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-11)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\u001b[K\r\n\u001b[K\r\n  \u001b[38;5;189mI've discovered that your local \u001b[m\u001b[38;5;111;48;5;236msam-node\u001b[m\u001b[38;5;189m isn't fully set up yet. To connect you to the mesh, let's complete the node enrollment\u001b[m\u001b[38;5;189m process.\u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189"]
