[174.947597, "o", "\n\u001b[38;5;146m  Checking Task Status\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-11)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 7s, 58 tokens\u001b[m\r\n\u001b[38;5;146m  Initiating Daemonization Process\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(sam-node run --daemonize)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-22)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 7s, 172 tokens\u001b[m\r\n\u001b[38;5;146m  Checking Daemonization Status\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(curl -s --unix-socket ~/.config/sam-mesh/sam.sock http://localhost/v1/models)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-26)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(cat /home/aojea/.config/sam-mesh/api-token)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought Process\u001b[m\r\n\u001b[38;5;1"]
[174.947605, "o", "46m  Demonstrating Mesh Connection\u001b[m\r\n  \u001b[38;5;189mAwesome, we've successfully authenticated and the \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m has been started locally!\u001b[96X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;39;1m### What just happened?\u001b[38;5;189;22m\u001b[157X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m1. We fetched an authorization code and joined the \u001b[1mOSS Agent Mesh (SAM)\u001b[22m.\u001b[108X\u001b[m\r\n  \u001b[38;5;189m2. We launched \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m in the background (daemonized), establishing your entry point into the SAM network.\u001b[73X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;39;1m### 1. Reaching SAM capabilities directly (HTTP/Unix socket)\u001b[38;5;189;22m\u001b[120X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mSince the \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m is running locally, we can reach it without needing any tokens if we use its Unix socket. This is perfect for querying SAM's connected AI models.\u001b[16X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mFor instance, I just automatically queried \u001b[38;5;111;48;5;236m/v1/models\u001b["]
[174.948035, "o", "38;5;189;49m across the mesh and found two endpoints available:\u001b[76X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m• \u001b[38;5;111;48;5;236mgoogle/gemma-2-2b-it\u001b[38;5;189;49m\u001b[158X\u001b[m\r\n  \u001b[38;5;189m• \u001b[38;5;111;48;5;236mopenrouter/auto\u001b[38;5;189;49m\u001b[163X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mWe can send a chat completion request directly to a mesh model. Here's an example you can run straight in your terminal to see it in action:\u001b[40X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m  \u001b[38;5;251mcurl --unix\u001b[38;5;189m\u001b[167X\u001b[m\r\n⣷  \u001b[38;5;109mGenerating...\u001b[m\r\n\u001b[38;5;238m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
