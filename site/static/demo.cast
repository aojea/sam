[175.112091, "o", "\u001b[?25l\r\u001b[66A\u001b[K\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(sam-node join --headless --auth-mode oob https://bananas.sam-mesh.dev)\u001b[m\n\u001b[75D\u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-11)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\u001b[K\n  \u001b[38;5;189mI've discovered that your local \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m isn't fully set up yet. To connect you to the mesh, let's complete the node enrollment process.\u001b[44X\u001b[m\r\n  \u001b[38;5;189m\u001b[136X\u001b[m\n\u001b[38;5;189mPlease follow these steps to authenticate your node:\u001b[m\r\n  \u001b[38;5;189m\u001b[52X\u001b[m\n\u001b[38;5;189m1. Open this URL in your web browser to authorize the node:\u001b[m\r\n  \u001b[38;5;35;1m\u001b]8;id=755170056;https://auth.sam-mesh.dev/auth?audience=sam-mesh-audience&client_id=sam-mesh-audience&code_challenge=mxtvOBa9zzvGi_KJRxfPyhlKvo-yxS73Nhfsv67NkVI&code_challenge_method=S256&redirect_uri=urn%3Aietf%3Awg%3Aoauth%3A2.0%3Aoob&response_type=code&scope=openid+email+profile&state=L7NW4r3kUsxOk-agKxw2gA\u0007SAM Mesh Authorization\u001b[38;5;189;22m\u001b]8"]
