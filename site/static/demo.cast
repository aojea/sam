[329.911567, "o", "\u001b[?25l\r\u001b[66A  \u001b[38;5;189mThe \u001b[m\u001b[38;5;111;48;5;236msam-node\u001b[m\u001b[38;5;189m MCP service is up and running! I just tested the local HTTP endpoint \u001b[m\u001b[38;5;111;48;5;236m\u001b]8;id=jk72e0e2d5;http://127.0.0.1:8080/mcp\u001b\\http://127.0.0.1:8080/mcp\u001b]8;;\u001b\\\u001b[m\u001b[38;5;189m and it successfully responded to an MCP protocol\u001b[m\u001b[38;5;189m request.\u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[K\r\n  \u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;18"]
