[177.327411, "o", "\u001b[?25l\r\u001b[66A  \u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;"]
[177.327482, "o", "5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;18"]
[177.327701, "o", "9m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[K\r\n\u001b[?5W\u001b[J  \u001b[38;5;189mOnce you provide the code, I'll send it to the setup process and finish starting up the local \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m and exploring the mesh!\u001b[54X\u001b[m\r\n\n\u001b[38;5;238m──────────────────────────────────────────────────"]
[177.32772, "o", "──────────\u001b[m\r\n\u001b[38;5;111;1m> jp2ekbobpfgmqdvzojzddyhg5\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 1s, 293 tokens\u001b[m\r\n\u001b[38;5;146m  Reviewing Authentication Code\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(send_input 8444cce5-beab-4803-ba8b-86fec8ea517d/task-11)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 4s, 107 tokens\u001b[m\r\n\u001b[38;5;146m  Checking Task Status\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-11)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 7s, 58 tokens\u001b[m\r\n\u001b[38;5;146m  Initiating Daemonization Process\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(sam-node run --daemonize)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-22)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought for 7s, 172 tokens\u001b[m\r\n\u001b[38;5;146m  Checking Daemonization Status\u001b[m\r\n\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m"]
[177.327764, "o", "(curl -s --unix-socket ~/.config/sam-mesh/sam.sock http://localhost/v1/models)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mManageTask\u001b[38;5;146;22m(status 8444cce5-beab-4803-ba8b-86fec8ea517d/task-26)\u001b[m\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(cat /home/aojea/.config/sam-mesh/api-token)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\n\u001b[38;5;146m▸ Thought Process\u001b[m\r\n\u001b[38;5;146m  Demonstrating Mesh Connection\u001b[m\r\n  \u001b[38;5;189mAwesome, we've successfully authenticated and the \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m has been started locally!\u001b[96X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;39;1m### What just happened?\u001b[38;5;189;22m\u001b[157X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m1. We fetched an authorization code and joined the \u001b[1mOSS Agent Mesh (SAM)\u001b[22m.\u001b[108X\u001b[m\r\n  \u001b[38;5;189m2. We launched \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m in the background (daemonized), establishing your entry point into the SAM network.\u001b[73X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;39;1m### 1. Reaching SAM capabilities directly (HTTP/Unix socket)\u001b[38;"]
[177.32778, "o", "5;189;22m\u001b[120X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mSince the \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m is running locally, we can reach it without needing any tokens if we use its Unix socket. This is perfect for querying SAM's connected AI models.\u001b[16X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mFor instance, I just automatically queried \u001b[38;5;111;48;5;236m/v1/models\u001b[38;5;189;49m across the mesh and found two endpoints available:\u001b[76X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m• \u001b[38;5;111;48;5;236mgoogle/gemma-2-2b-it\u001b[38;5;189;49m\u001b[158X\u001b[m\r\n  \u001b[38;5;189m• \u001b[38;5;111;48;5;236mopenrouter/auto\u001b[38;5;189;49m\u001b[163X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mWe can send a chat completion request directly to a mesh model. Here's an example you can run straight in your terminal to see it in action:\u001b[40X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m  \u001b[38;5;251mcurl --unix-socket ~/.config/sam-mesh/sam.sock \u001b[38;5;158m\\\u001b[38;5;189m\u001b[130X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  \u001b]8;id=jke32253df;http://localhost/v1/chat/completions\u0007http:"]
[177.327832, "o", "//localhost/v1/chat/completions\u001b]8;;\u0007 \u001b[38;5;158m\\\u001b[38;5;189m\u001b[138X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  -H \u001b[38;5;173m'Content-Type: application/json'\u001b[38;5;251m \u001b[38;5;158m\\\u001b[38;5;189m\u001b[139X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  -d \u001b[38;5;173m'{\"model\": \"google/gemma-2-2b-it\", \"messages\": [{\"role\": \"user\", \"content\": \"Hello from the SAM mesh demo!\"}]}'\u001b[38;5;189m\u001b[62X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;39;1m### 2. Discovering remote APIs and Tools\u001b[38;5;189;22m\u001b[140X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189mYou can give agents (like me!) access to networked tools. The mesh nodes discover these using the MCP (Model Context Protocol). Here's how to configure me to have first-class      \u001b[m\r\n  \u001b[38;5;189maccess to any tools running on the mesh endpoints so I don't have to \u001b[38;5;111;48;5;236mcurl\u001b[38;5;189;49m:\u001b[106X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m1. Open your Antigravity MCP settings: \u001b[38;5;111;48;5;236m~/.gemini/config/mcp_config.json\u001b[38;5;189;49m\u001b[109X\u001b[m\r\n  \u001b[38;5;189m2. Add the SAM MCP server using the node API"]
[177.327863, "o", " token we just generated (which is safely tucked away in \u001b[38;5;111;48;5;236m~/.config/sam-mesh/api-token\u001b[38;5;189;49m):\u001b[49X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\n\u001b[38;5;189m  \u001b[38;5;187m{\u001b[38;5;189m\u001b[177X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  \u001b[38;5;140m\"mcpServers\"\u001b[38;5;187m:\u001b[38;5;251m \u001b[38;5;187m{\u001b[38;5;189m\u001b[161X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m    \u001b[38;5;255;48;5;203m\"sam\u001b[38;5;189;49m\u001b[170X\u001b[m\r\n⣻  \u001b[38;5;109mG\u001b[38;5;111menera\u001b[38;5;109mting...\u001b[m\r\n\u001b[38;5;238m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\u001b[38;5;1"]
