[282.81397, "o", "\u001b[?25l\r\u001b[66A  \u001b[38;5;189;3mNote: You would replace \u001b[m\u001b[38;5;111;48;5;236m<paste-your-token-here>\u001b[m\u001b[38;5;189;3m with the contents of your \u001b[m\u001b[38;5;111;48;5;236mapi-token\u001b[m\u001b[38;5;189;3m file.\u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b[38;5;189m \u001b[m\u001b["]
