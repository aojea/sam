[207.277952, "o", "\u001b[?25l\u001b[66A\u001b[5C\u001b[38;5;146mcurl -s --unix-socket ~/.config/sam-mesh/sam.sock http://localhost/v1/models)\u001b[m\n\u001b[21D\u001b[38;5;146m6)\u001b[m\u001b[K\r\n\u001b[38;5;111m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(cat /home/aojea/.config/sam-mesh/api-token)\u001b[m \u001b[38;5;146m(ctrl+o to expand)\u001b[m\r\n\u001b[K\n\u001b[38;5;146m▸ Thought for 20s, 139 tokens\u001b[m\u001b[K\r\n\u001b[38;5;146m  Demonstrating Mesh Connection\u001b[m\r\n  \u001b[38;5;189mAwesome, we've successfully authenticated and the \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m has been started locally!\u001b[96X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\r\n  \u001b[38;5;39;1m### What just happened?\u001b[38;5;189;22m\u001b[157X\u001b[m\r\n  \u001b[38;5;189m\u001b[180X\u001b[m\r\n  \u001b[38;5;189m1. We fetched an authorization code and joined the \u001b[1mOSS Agent Mesh (SAM)\u001b[22m.\u001b[108X\u001b[m\r\n  \u001b[38;5;189m2. We launched \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m in the background (daemonized), establishing your entry point into the SAM network.\u001b[73X\u001b[m\r\n  \u001b[38;5;189m\u001b[84X\u001b[m\n\u001b[38;5;39;1m### 1. Reaching SAM capabilities directly (HTTP/Unix socket)\u001b[m\r\n  \u001b[38;5;189m\u001b[23X\u001b[m\n\u001b[38;5;189mSince t"]
[207.278478, "o", "he \u001b[38;5;111;48;5;236msam-node\u001b[38;5;189;49m is running locally, we can reach it without needing any tokens if we use its Unix socket. This is perfect for querying SAM's connected AI models.\u001b[m\r\n  \u001b[38;5;189m\u001b[72X\u001b[m\n\u001b[38;5;189mFor instance, I just automatically queried \u001b[38;5;111;48;5;236m/v1/models\u001b[38;5;189;49m across the mesh and found two endpoints available:   \u001b[m\r\n\n  \u001b[38;5;189m• \u001b[38;5;111;48;5;236mgoogle/gemma-2-2b-it\u001b[38;5;189;49m\u001b[38X\u001b[m\r\n  \u001b[38;5;189m• \u001b[38;5;111;48;5;236mopenrouter/auto\u001b[m\r\n  \u001b[38;5;189m\u001b[164X\u001b[m\n\u001b[38;5;189mWe can send a chat completion request directly to a mesh model. Here's an example you can run straight in your terminal to see it in action:\u001b[m\r\n  \u001b[38;5;189m\u001b[104X\u001b[m\n\u001b[2C\u001b[38;5;251mcurl --unix-socket ~/.config/sam-mesh/sam.sock \u001b[38;5;158m\\\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  \u001b]8;id=jke32253df;http://localhost/v1/chat/completions\u0007http://localhost/v1/chat/completions\u001b]8;;\u0007 \u001b[38;5;158m\\\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  -H \u001b[38;5;173m'Content-Type: application/json'\u001b[38;5;251m "]
[207.278619, "o", "\u001b[38;5;158m\\\u001b[m\n\u001b[39D\u001b[38;5;251m  -d \u001b[38;5;173m'{\"model\": \"google/gemma-2-2b-it\", \"messages\": [{\"role\": \"user\", \"content\": \"Hello from the SAM mesh demo!\"}]}'\u001b[m\r\n  \u001b[38;5;189m\u001b[140X\u001b[m\n\u001b[38;5;39;1m### 2. Discovering remote APIs and Tools\u001b[m\n\u001b[38D\u001b[38;5;189m\u001b[48X\u001b[m\n\b\b\u001b[38;5;189mYou can give agents (like me!) access to networked tools. The mesh nodes discover these using the MCP (Model Context Protocol). Here's how to configure me to have first-class\u001b[m\r\n  \u001b[38;5;189maccess to any tools running on the mesh endpoints so I don't have to \u001b[38;5;111;48;5;236mcurl\u001b[38;5;189;49m:\u001b[m\n\u001b[72D\u001b[38;5;189m\u001b[116X\u001b[m\n\b\b\u001b[38;5;189m1. Open your Antigravity MCP settings: \u001b[38;5;111;48;5;236m~/.gemini/config/mcp_config.json\u001b[m\r\n  \u001b[38;5;189m2. Add the SAM MCP server using the node API token we just generated (which is safely tucked away in \u001b[38;5;111;48;5;236m~/.config/sam-mesh/api-token\u001b[38;5;189;49m):\u001b[m\r\n\n  \u001b[38;5;189m  \u001b[38;5;187m{\u001b[38;5;189m\u001b[171X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m  \u001b[38;5;140m\"mcpServers\"\u001b[38;5;187m:\u001b[38;5;2"]
[207.278645, "o", "51m \u001b[38;5;187m{\u001b[38;5;189m\u001b[55X\u001b[m\n\u001b[17D\u001b[38;5;251m    \u001b[38;5;140m\"sam-mesh\"\u001b[38;5;187m:\u001b[38;5;251m \u001b[38;5;187m{\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m      \u001b[38;5;140m\"serverUrl\"\u001b[38;5;187m:\u001b[38;5;251m \u001b[38;5;173m\"\u001b]8;id=jk72e0e2d5;http://127.0.0.1:8080/mcp\u0007http://127.0.0.1:8080/mcp\u001b]8;;\u0007\"\u001b[38;5;187m,\u001b[38;5;189m\u001b[22X\u001b[m\r\n  \u001b[38;5;189m  \u001b[38;5;251m      \u001b[38;5;140m\"headers\"\u001b[38;5;187m:\u001b[38;5;251m \u001b[38;5;187m{\u001b[38;5;189m\u001b[111X\u001b[m\n\u001b[18D\u001b[38;5;251m        \u001b[38;5;140m\"X-Sam-Authentication\"\u001b[38;5;187m:\u001b[38;5;251m \u001b[38;5;173m\"Bearer <paste-your-token-here>\"\u001b[m\n\u001b[64D\u001b[38;5;251m      \u001b[38;5;187m}\u001b[m\n\u001b[5D\u001b[38;5;251m  \u001b[38;5;187m}\u001b[38;5;189m            \u001b[m\n\u001b[15D\u001b[38;5;187m}\u001b[38;5;189m\u001b[14X\u001b[m\n\b\b\b\u001b[38;5;187m}\u001b[38;5;189m\u001b[46X\u001b[m\n\b\u001b[38;5;189m\u001b[18X\u001b[m\n\b\b\u001b[38;5;189;3mNote: You would replace \u001b[38;5;111;48;5;236;23m<paste-your-token-here>\u001b[38;5;189;49;3m with the contents of your \u001b[38;5;111;48;5;236;23mapi-token\u001b[38;5;189;49;3m file.\u001b[m\n\u001b[87D\u001b[38;5;189m       \u001b[m\r\n  \u001b[38;5;189mAfter this configuration, any time you interact with me,"]
[207.278791, "o", " I will be able to transparently inspect mesh routing state, discover available microservices around the globe (inference,\u001b[m\r\n  \u001b[38;5;189mlocal_proxy_url mappings, remote MCP endpoints), read up on those remote tool schemas, and directly pipe inputs to them.\u001b[m\r\n\u001b[4C\u001b[38;5;189m  \u001b[m\r\n  \u001b[38;5;189mWould you like me to test-fire a prompt against the mesh model we found, or demonstrate how to query for specific peer services on the control plane?\u001b[m\r\n\u001b[K\n\u001b[38;5;238m────────────────────────────────────────────────────────────\u001b[m\u001b[K\r\n\u001b[38;5;111;1m> yes please\u001b[m\u001b[K\r\n\u001b[K\n\u001b[38;5;146m▸ Thought for 4s, 563 tokens\u001b[m\u001b[K\r\n\u001b[38;5;146m  Reviewing Initial Options\u001b[m\u001b[K\r\n\n\u001b[38;5;214m●\u001b[m \u001b[38;5;214;1mBash\u001b[38;5;146;22m(curl -s --unix-socket ~/.config/sam-mesh/sam.sock http://localhost/v1/chat/completions -H 'Content-Type: application/json' -d '{\"model\": \"google/gemma-2-2b-i...)\u001b[m \u001b[38;5;146m(ctrl+o "]
